+/* OpenMW: a single application scene, with SDL's existing window/view/input
+ * ownership. Do not run the blocking SDL_main from willConnectToSession. */
+@implementation OpenMWSDLSceneDelegate
+- (void)scene:(UIScene *)scene willConnectToSession:(UISceneSession *)session options:(UISceneConnectionOptions *)options
+{
+    if (![scene isKindOfClass:[UIWindowScene class]]) return;
+    SDLUIKitDelegate *app = [SDLUIKitDelegate sharedAppDelegate];
+    if (app.openmwWindowScene && app.openmwWindowScene != scene) return;
+    app.openmwWindowScene = (UIWindowScene *)scene;
+    /* A disconnected scene may reconnect without restarting the engine. */
+    app.window.windowScene = app.openmwWindowScene;
+    for (UIOpenURLContext *context in options.URLContexts) {
+        [app sendDropFileForURL:context.URL];
+    }
+}
+- (void)sceneDidBecomeActive:(UIScene *)scene
+{
+    SDLUIKitDelegate *app = [SDLUIKitDelegate sharedAppDelegate];
+    if (scene != app.openmwWindowScene) return;
+    [app.window makeKeyAndVisible];
+    SDL_OnApplicationDidBecomeActive();
+    [app performSelector:@selector(postFinishLaunch) withObject:nil afterDelay:0.0];
+}
+- (void)sceneWillResignActive:(UIScene *)scene
+{
+    SDLUIKitDelegate *app = [SDLUIKitDelegate sharedAppDelegate];
+    if (scene != app.openmwWindowScene) return;
+    [NSObject cancelPreviousPerformRequestsWithTarget:app selector:@selector(postFinishLaunch) object:nil];
+    SDL_OnApplicationWillResignActive();
+}
+- (void)sceneDidEnterBackground:(UIScene *)scene
+{
+    if (scene == [[SDLUIKitDelegate sharedAppDelegate] openmwWindowScene]) SDL_OnApplicationDidEnterBackground();
+}
+- (void)sceneWillEnterForeground:(UIScene *)scene
+{
+    if (scene == [[SDLUIKitDelegate sharedAppDelegate] openmwWindowScene]) SDL_OnApplicationWillEnterForeground();
+}
+- (void)sceneDidDisconnect:(UIScene *)scene
+{
+    SDLUIKitDelegate *app = [SDLUIKitDelegate sharedAppDelegate];
+    if (scene != app.openmwWindowScene) return;
+    [NSObject cancelPreviousPerformRequestsWithTarget:app selector:@selector(postFinishLaunch) object:nil];
+    app.window.hidden = YES;
+    app.window.windowScene = nil;
+    app.openmwWindowScene = nil;
+}
+- (void)scene:(UIScene *)scene openURLContexts:(NSSet<UIOpenURLContext *> *)contexts
+{
+    SDLUIKitDelegate *app = [SDLUIKitDelegate sharedAppDelegate];
+    if (scene != app.openmwWindowScene) return;
+    for (UIOpenURLContext *context in contexts) [app sendDropFileForURL:context.URL];
+}
+@end
+
 #endif /* SDL_VIDEO_DRIVER_UIKIT */
 
